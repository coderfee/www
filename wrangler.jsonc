{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/worker.ts",
  "keep_vars": true,
  "compatibility_date": "2026-06-23",
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "coderfee.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "secrets_store_secrets": [
    {
      "binding": "BLOG_API_TOKEN_STORE",
      "store_id": "f6197f32d6324add9f15103423616f82",
      "secret_name": "BLOG_API_TOKEN"
    },
    {
      "binding": "GITHUB_TOKEN_STORE",
      "store_id": "f6197f32d6324add9f15103423616f82",
      "secret_name": "GITHUB_TOKEN"
    }
  ]
}
