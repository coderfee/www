---
import BaseLayout from './BaseLayout.astro';

const { title, description, seoDescription, cover, showBottomNavigation } = Astro.props;
---

<BaseLayout
  title={`明日周刊 · ${title}`}
  description={seoDescription ?? description}
  ogImage={cover}
  type="article"
  showBottomNavigation={showBottomNavigation}
>
  <Fragment slot="head">
    <meta name="keywords" content={`明日周刊，${title}`}>
    <link rel="alternate" type="application/rss+xml" title="明日周刊" href={new URL('newsletter.xml', Astro.site)}>
  </Fragment>
  <div class="relative"><slot /></div>
</BaseLayout>
