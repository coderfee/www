---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostBottomBar from '@/components/blog/PostBottomBar.tsx';
import PostComments from '@/components/blog/PostComments.astro';
import PostHeader from '@/components/blog/PostHeader.astro';
import PostLicense from '@/components/blog/PostLicense.astro';
import PostNavigation from '@/components/blog/PostNavigation.astro';
import PostRelatedPosts from '@/components/blog/PostRelatedPosts.astro';
import { TOCDesktop } from '@/components/blog/toc/TableOfContents.tsx';
import ShareButton from '@/components/ui/ShareButton.tsx';
import { AUTHOR } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import IconArrowLeft from '~icons/tabler/arrow-left';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(({ data: { draft = false } }) => !draft);
  const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sortedPosts.map((post, index) => {
    const next = index + 1 < sortedPosts.length ? sortedPosts[index + 1] : null;
    const prev = index - 1 >= 0 ? sortedPosts[index - 1] : null;
    return {
      params: { slug: post.data.slug },
      props: { post, prev, next },
    };
  });
}

type Props = {
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
};

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, tldr, seoDescription, date, updated, tags = [], cover, keywords } = post.data;
const slug = post.data.slug;
const modifiedDate = updated ?? date;
const coverImage = typeof cover === 'string' ? cover : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = new URL(coverImage ?? '/og-default.png', Astro.site).toString();
const postKeywords = keywords?.length ? keywords : tags;
const metaDescription = seoDescription ?? tldr;
const firstTag = tags[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: metaDescription,
  image: [imageURL],
  url: canonicalURL,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  datePublished: date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: 'zh-Hans',
  author: {
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).toString(),
    name: AUTHOR,
    url: new URL('/', Astro.site).toString(),
    sameAs: ['https://github.com/coderfee'],
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
    name: AUTHOR,
    url: new URL('/', Astro.site).toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icons/icon-512.png', Astro.site).toString(),
      width: 512,
      height: 512,
    },
  },
  ...(firstTag ? { articleSection: firstTag } : {}),
  ...(postKeywords.length > 0 ? { keywords: postKeywords.join(', ') } : {}),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: new URL('/', Astro.site).toString(),
    },
    ...(firstTag
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: `#${firstTag}`,
            item: new URL(`/blog/tags/${encodeURIComponent(firstTag)}/`, Astro.site).toString(),
          },
        ]
      : []),
    {
      '@type': 'ListItem',
      position: firstTag ? 3 : 2,
      name: title,
      item: canonicalURL,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={metaDescription}
  ogImage={coverImage}
  type="article"
  showBottomNavigation={false}
>
  <TOCDesktop client:media="(min-width: 1280px)" headings={headings} />
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()}>
    <meta property="article:modified_time" content={modifiedDate.toISOString()}>
    <meta property="article:author" content={AUTHOR}>
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {postKeywords.length > 0 && <meta name="keywords" content={postKeywords.join(', ')} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article class="relative min-h-screen animate-in fade-in slide-in-from-bottom-8 duration-700">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <button
        onclick="history.back()"
        class="hidden md:inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors mb-8 group cursor-pointer"
      >
        <IconArrowLeft class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" />
        <span>返回</span>
      </button>

      <PostHeader title={title} date={date} tags={tags} tldr={tldr} />

      <div class="w-full my-10 border-t border-dashed border-zinc-200/30 dark:border-zinc-700/30"></div>

      <div
        class="prose prose-zinc dark:prose-invert max-w-none
           prose-headings:font-bold prose-headings:tracking-tight prose-p:leading-loose
           prose-headings:text-zinc-900 dark:prose-headings:text-zinc-100
           prose-p:text-zinc-600 dark:prose-p:text-zinc-300
           prose-img:rounded-xl prose-img:mx-auto text-justify prose-headings:font-noto break-all"
        style="text-justify: inter-character;"
      >
        <Content />
      </div>

      <div class="mt-8"><PostLicense /></div>

      <ShareButton client:load title={title} description={tldr} />

      <div class="w-full my-10 border-t border-dashed border-zinc-200/30 dark:border-zinc-700/30"></div>

      <PostNavigation prev={prev} next={next} />

      <PostRelatedPosts currentSlug={slug} tags={tags} />

      <PostComments />
    </div>
  </article>

  <PostBottomBar
    client:load
    title={title}
    description={tldr}
    url={new URL(Astro.url.pathname, Astro.site).toString()}
    headings={headings}
  />
</BaseLayout>
