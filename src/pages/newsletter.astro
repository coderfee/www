---
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import NewsletterGrid from '@/components/newsletter/NewsletterGrid.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';

const collection = await getCollection('newsletter', ({ data }) => !data.draft);
const newsletters = collection.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const newsletterItems = newsletters.map((item) => ({
  id: item.id,
  data: item.data,
}));

const title = '明日周刊';
const description =
  '明日周刊是 coderfee 的每周 Newsletter，内容涵盖技术阅读、AI 动态、工具推荐、生活思考与读书笔记，每周一期，支持 RSS 订阅和往期回顾。适合想持续跟进 AI、前端与独立开发动态的读者。';
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 py-12 lg:py-20 relative z-10">
    <NewsletterGrid client:load items={newsletterItems} title={title} />
  </div>
</BaseLayout>
