---
import ReadingStats from '@/components/reading/ReadingStats.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = '阅读';
const description =
  'coderfee 的微信读书统计与近期阅读记录，包含周、月、年和总览维度的阅读时长、读完书目与笔记数量，以及近期在读和想读的书单，持续更新。适合想了解我最近在读什么、读了多久的读者。';
---

<BaseLayout title={title} description={description}>
  <ReadingStats client:load />
</BaseLayout>
