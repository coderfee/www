    "@cloudflare/workers-types": "^5.20260829.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "latest",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.12",
    "unplugin-icons": "^23.0.1",
    "wrangler": "^4.127.1"
